{
  "name": "mj",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/catalog",
      "/catalog/",
      "/maknoon-jamil",
      "/maknoon-jamil/*",
      "/pop-and-petals",
      "/pop-and-petals/*",
      "/flawless-glow-co",
      "/flawless-glow-co/*",
      "/products/*",
      "/shops/*",
      "/manage/*",
      "/platform-admin",
      "/platform-admin/",
      "/shop-media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "mj-database",
      "database_id": "d20ec4cb-6a13-48e7-9097-f1c451e33531",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SHOP_IMAGES",
      "bucket_name": "mj-shop-images"
    }
  ]
}
